# Cryptomus Merchant (https://doc.cryptomus.com/)
CRYPTOMUS_MERCHANT_ID=your-merchant-uuid
CRYPTOMUS_PAYMENT_API_KEY=your-payment-api-key

# Public site URL (no trailing slash)
# Local: http://localhost:3000
# Production: https://kriptostore.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL for Payload (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soguk_payload

# To seed production from your PC, temporarily set DATABASE_URL to Supabase
# Session pooler URI with ?sslmode=no-verify (do not commit real secrets).

# Payload CMS admin secret — required; production: ≥32 random chars
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Schema push on boot (default true). Set false after first successful prod schema sync.
# PAYLOAD_DATABASE_PUSH=true

# Force TLS for managed Postgres (Supabase). Auto-on when NODE_ENV=production.
# DATABASE_SSL=true

# Supabase Storage (S3-compatible) — Payload Media uploads
# Bucket `media` already created (public). Keys: Dashboard → Storage → S3 Connection
# Local create/repair: npm run db:storage:media  (needs Supabase DATABASE_URL, not localhost)
# S3_BUCKET=media
# S3_REGION=eu-west-2
# S3_ENDPOINT=https://pykgcmqwrngdccxrhrld.storage.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://pykgcmqwrngdccxrhrld.supabase.co/storage/v1/object/public/media

# Hostinger mailbox SMTP (contact form + order emails)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=support@kriptostore.com
# SMTP_PASS=your-mailbox-password
# SMTP_FROM=support@kriptostore.com
# SMTP_SKIP_VERIFY=true

# --- SEO / Analytics (optional; leave blank until you have IDs) ---
# Google Search Console → Settings → Ownership verification → HTML tag content=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Google Analytics 4 Measurement ID (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# Meta (Facebook) Pixel ID
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000